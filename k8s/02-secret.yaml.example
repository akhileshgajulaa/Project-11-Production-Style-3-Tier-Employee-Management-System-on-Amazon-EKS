# Copy this file to 02-secret.yaml and fill in real values before applying.
# 02-secret.yaml is git-ignored on purpose — never commit real credentials.
#
# For a production deployment, prefer AWS Secrets Manager, the External
# Secrets Operator, or another managed secret store instead of a plain
# Kubernetes Secret checked out on a laptop.
apiVersion: v1
kind: Secret
metadata:
  name: ems-secret
  namespace: ems
type: Opaque
stringData:
  MYSQL_ROOT_PASSWORD: "<CHANGE_ME>"
  DB_USERNAME: "<CHANGE_ME>"
  DB_PASSWORD: "<CHANGE_ME>"
  JWT_SECRET: "<CHANGE_ME_MINIMUM_32_CHARACTERS>"
